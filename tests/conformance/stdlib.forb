Pt:=struct{X:i64,Y:i64}
Nums:[]i64=array{1,2,3,1,2,3}
Tens:[]i64=array{10,20,30,40,50}
None:[]i64=array{}
Name:string="José"
var Stock:[]i64=array{4,5,6}
Where[T:comparable](Items:[]T,Wanted:T)<computes><decides>:i64{Items.Find[Wanted]}
Take(V:i64)<transacts><decides>:i64=Block{set Stock=Stock.RemoveFirstElement[V];Stock.Find[6]}
SafeDivide(X:float,Y:float)<computes><decides>:float=Block{X.IsFinite[];Y.IsFinite[];(X/Y).IsFinite[]}
Hyp(X:float,Y:float)<computes>:float=Sqrt(X*X+Y*Y)
Found<public>:i64=Attempt(Nums.Find[2],-1)
Missing<public>:i64=Attempt(Nums.Find[0],-1)
Fruit<public>:i64=Attempt(Where[string][array{"Apple","Orange","Strawberry"},"Strawberry"],-1)
Point<public>:i64=Attempt(array{Pt{X:=1,Y:=2},Pt{X:=3,Y:=4}}.Find[Pt{X:=3,Y:=4}],-1)
NotANumber<public>:i64=Attempt(array{1.0,NaN}.Find[NaN],-1)
Mid<public>:[]i64=Attempt(Tens.Slice[1,4],None)
Tail<public>:[]i64=Attempt(Tens.Slice[2],None)
EmptySlice<public>:[]i64=Attempt(Tens.Slice[2,2],array{-1})
Backwards<public>:[]i64=Attempt(Tens.Slice[2,1],array{-1})
Beyond<public>:[]i64=Attempt(Tens.Slice[0,10],array{-1})
FirstGone<public>:[]i64=Attempt(Nums.RemoveFirstElement[2],None)
NoneGone<public>:[]i64=Attempt(Nums.RemoveFirstElement[0],array{-1})
AllGone<public>:[]i64=Nums.RemoveAllElements(2)
Cut<public>:[]i64=Attempt(Tens.Remove[1,2],None)
CutBeyond<public>:[]i64=Attempt(Tens.Remove[6,10],array{-1})
FirstNew<public>:[]i64=Attempt(Nums.ReplaceFirstElement[2,99],None)
AllNew<public>:[]i64=Nums.ReplaceAllElements(2,99)
At<public>:[]i64=Attempt(Tens.ReplaceElement[1,99],None)
AtBeyond<public>:[]i64=Attempt(Tens.ReplaceElement[10,99],array{-1})
Runs<public>:[]i64=array{1,2,3,4,2,3,5}.ReplaceAll(array{2,3},array{99})
Longer<public>:[]i64=array{1,2,2,1,2,2,1}.ReplaceAll(array{2,2},array{9,9,9})
Overlap<public>:[]i64=array{1,1,1,1,1}.ReplaceAll(array{1,1},array{2})
Inserted<public>:[]i64=Attempt(Tens.Insert[2,array{25}],None)
Appended<public>:[]i64=Attempt(None.Insert[0,array{7}],None)
InsertBeyond<public>:[]i64=Attempt(Tens.Insert[6,array{5}],array{-1})
Flat<public>:[]i64=Concatenate(array{array{1,2,3},None,array{4}})
Many<public>:[]i64=Concatenate(array{1},array{2,3},array{4},array{5,6})
Last<public>:i64=Attempt(Tens.Last[],-1)
LastTwoBack<public>:i64=Attempt(Tens.Last[2],-1)
LastOfNone<public>:i64=Attempt(None.Last[],-1)
LastNegative<public>:i64=Attempt(Tens.Last[-1],-1)
Chain<public>:i64=Attempt(Tens.Insert[0,array{9}].Remove[1,2].ReplaceElement[0,7].Find[30],-1)
Kept<public>:i64=Attempt(Take[5],-1)
Stocked<public>:[]i64=Stock
Undone<public>:i64=Attempt(Take[6],-1)
Restocked<public>:[]i64=Stock
Merged<public>:map(i64,string)=ConcatenateMaps(map{1=>"original",2=>"base"},map{2=>"updated",3=>"new"})
MergedEmpty<public>:map(i64,string)=ConcatenateMaps(Merged,map{})
ByPoint<public>:map(Pt,i64)=ConcatenateMaps(map{Pt{X:=0,Y:=0}=>1},map{Pt{X:=0,Y:=0}=>2,Pt{X:=1,Y:=1}=>3})
Replaced<public>:string="Hey, this is a string, Hello!".ReplaceAll("He","Apples")
Unaccented<public>:string=Name.ReplaceAll("é","e")
Unit<public>:i64=Attempt(Name.Find['s'],-1)
NoUnit<public>:i64=Attempt(Name.Find['x'],-1)
Dashed<public>:string=Attempt(Name.Insert[3,"-"],"!")
Split<public>:string=Attempt(Name.Insert[4,"-"],"!")
Shorter<public>:string=Attempt(Name.Remove[1,3],"!")
SplitCut<public>:string=Attempt(Name.Remove[3,4],"!")
LastUnit<public>:char=Attempt(Name.Last[],'?')
Joined<public>:string=Join(array{"a","b","c"},", ")
Glued<public>:string=Concatenate("ab",Name,"cd")
Shown<public>:string=ToString(Name)
AbsInt<public>:i64=Abs(-5)
AbsFloat<public>:float=Abs(-3.14)
Least<public>:i64=Min(3,-4)
Most<public>:i64=Max(3,-4)
MaxNaN<public>:float=Max(NaN,5.0)
MinInf<public>:float=Min(-Inf,100.0)
Clamped<public>:i64=Clamp(5,2,-2)
ClampedFloat<public>:float=Clamp(0.5,1.0,3.0)
Root<public>:float=Sqrt(2.0)
RootOfNegative<public>:float=Sqrt(-1.0)
Cube<public>:float=Pow(2.0,3.0)
PowZero<public>:float=Pow(NaN,0.0)
E<public>:float=Exp(1.0)
One<public>:float=Ln(E)
LnZero<public>:float=Ln(0.0)
Decades<public>:float=Log(10.0,100.0)
Sine<public>:float=Sin(1.0)
Cosine<public>:float=Cos(1.0)
Tangent<public>:float=Tan(1.0)
SinePi<public>:float=Sin(PiFloat)
QuarterTurn<public>:float=ArcTan(1.0,1.0)
HalfTurn<public>:float=ArcCos(-1.0)
OutOfDomain<public>:float=ArcSin(2.0)
Origin<public>:float=ArcTan(0.0,0.0)
Hyperbolic<public>:float=Sinh(1.0)+Cosh(1.0)-Tanh(1.0)
Inverse<public>:float=ArSinh(1.0)+ArCosh(2.0)+ArTanh(0.5)
Blend<public>:float=Lerp(3.0,7.0,0.25)
Beyond1<public>:float=Lerp(3.0,7.0,2.0)
Diagonal<public>:float=Hyp(3.0,4.0)
Finite<public>:float=Attempt(SafeDivide[10.0,4.0],-1.0)
Infinite<public>:float=Attempt(SafeDivide[10.0,0.0],-1.0)
