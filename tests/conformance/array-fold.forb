Fold[T:type,A:type](Step:function(tuple(T,A),T),Items:[]A,Init:T)<computes>:T{Loop(Fn[Step:function(tuple(T,A),T)=Step,Items:[]A=Items](S:tuple(i64,T))<computes>:option(tuple(i64,T)){Attempt(option{tuple{S(0)+1,Step(S(1),Items[S(0)])}},option{})},tuple{0,Init})(1)}
Add(Total:i64,N:i64)<computes>:i64=Total+N
Larger(Best:i64,N:i64)<computes>:i64=If(N>Best,N,Best)
Join(Text:string,Part:string)<computes>:string=If(Part==Text,Text,Part)
Items:[]i64=array{3,9,4}
Nothing:[]i64=array{}
Words:[]string=array{"a","b"}
Sum<public>:i64=Fold[i64,i64](Add,Items,100)
Largest<public>:i64=Fold[i64,i64](Larger,Items,0)
Empty<public>:i64=Fold[i64,i64](Add,Nothing,7)
Last<public>:string=Fold[string,string](Join,Words,"none")
