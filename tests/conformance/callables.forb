var Cell:i64=1
Visit(N:i64)<transacts><decides>:i64=Block{
 set Cell=Cell+N
 Require[N>0]
 Cell
}
box:=struct{F:function<transacts><decides>(tuple(i64),i64)=Visit}
Make()<computes>:box=box{}
Run(F:function<transacts><decides>(tuple(i64),i64),N:i64)<transacts><decides>:i64=F[N]
B:box=Make()
Selected<public>:function<transacts><decides>(tuple(i64),i64)=B.F
Good<public>:i64=Attempt(Run[Selected,2],0)
Recovered<public>:i64=Attempt(Selected[-4],Cell)
Total<public>:i64=Good+Recovered+Cell
