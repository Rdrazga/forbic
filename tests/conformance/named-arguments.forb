Base:i64=100
Pt:=struct{V:i64=7}
Show(A:i64,B:i64=10,C:string="x")<computes>:string=ToString(A)+"|"+ToString(B)+"|"+C
Total(A:i64,Extra:i64=Base+1)<computes>:i64=A+Extra
Count(Xs:[]i64=array{1,2,3},Fallback:option(i64)=option{})<computes>:i64=Xs.Length+Or(Fallback,40)
Rec(P:Pt=Pt{V:=3})<computes>:i64=P.V
Fact(K:i64,Acc:i64=1)<computes>:i64=If(K<=1,Acc,Fact(K-1,Acc*K))
A<public>:string=Show(1)
B<public>:string=Show(1,2,"y")
C<public>:string=Show(1,C:="z")
D<public>:string=Show(C:="q",A:=9,B:=8)
E<public>:string=Show(5,C:="m",B:=6)
F<public>:i64=Total(1)
G<public>:i64=Total(1,Extra:=2)
H<public>:i64=Count()
I<public>:i64=Count(Fallback:=option{5})
J<public>:i64=Count(Xs:=array{9})
K<public>:i64=Rec()+Rec(Pt{})
L<public>:i64=Fact(5)
