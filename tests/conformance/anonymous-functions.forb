var Cell:i64=1
box:=struct{F:function<transacts><decides>(tuple(i64),option(i64))=Fn[Amount:i64=2](N:i64)<transacts><decides>:option(i64){Block{
 set Cell=Cell+Amount
 Require[N<5]
 If(N<3,option{N+1},option{})
}}}
Make()<computes>:box=box{}
Run(F:function<transacts><decides>(tuple(i64),option(i64)),X:i64)<transacts><decides>:i64=Loop(F,X)
B:box=Make()
Selected<public>:function<transacts><decides>(tuple(i64),option(i64))=B.F
Good<public>:i64=Attempt(Run[Selected,0],0)
Recovered<public>:i64=Attempt(Loop(Selected,5),Cell)
Total<public>:i64=Good+Recovered+Cell
